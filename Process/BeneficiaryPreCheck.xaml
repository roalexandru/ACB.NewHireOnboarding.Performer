<Activity mc:Ignorable="sap sap2010" x:Class="BeneficiaryPreCheck" mva:VisualBasic.Settings="{x:Null}"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:njl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:web="clr-namespace:UiPath.Web.Activities;assembly=UiPath.Web.Activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Members>
        <x:Property Name="in_BaseUrl" Type="InArgument(x:String)" />
        <x:Property Name="in_ApiKey" Type="InArgument(x:String)" />
        <x:Property Name="in_EmployeeId" Type="InArgument(x:String)" />
        <x:Property Name="in_HasLifeLine" Type="InArgument(x:Boolean)" />
        <x:Property Name="out_IsValid" Type="OutArgument(x:Boolean)" />
        <x:Property Name="out_ExceptionCode" Type="OutArgument(x:String)" />
        <x:Property Name="out_Detail" Type="OutArgument(x:String)" />
    </x:Members>
    <TextExpression.NamespacesForImplementation>
        <sco:Collection x:TypeArguments="x:String">
            <x:String>System.Activities</x:String><x:String>System</x:String><x:String>System.Linq</x:String><x:String>Newtonsoft.Json.Linq</x:String><x:String>UiPath.Core.Activities</x:String><x:String>UiPath.Web.Activities</x:String>
        </sco:Collection>
    </TextExpression.NamespacesForImplementation>
    <TextExpression.ReferencesForImplementation>
        <sco:Collection x:TypeArguments="AssemblyReference">
            <AssemblyReference>System.Activities</AssemblyReference><AssemblyReference>System</AssemblyReference><AssemblyReference>System.Linq</AssemblyReference><AssemblyReference>System.Private.CoreLib</AssemblyReference><AssemblyReference>Newtonsoft.Json</AssemblyReference><AssemblyReference>UiPath.System.Activities</AssemblyReference><AssemblyReference>UiPath.Web.Activities</AssemblyReference>
        </sco:Collection>
    </TextExpression.ReferencesForImplementation>
    <Sequence DisplayName="C-05 Beneficiary Pre-check">
        <Sequence.Variables>
            <Variable x:TypeArguments="x:Int32" Name="status" />
            <Variable x:TypeArguments="x:String" Name="body" />
            <Variable x:TypeArguments="x:String" Name="errCode" />
            <Variable x:TypeArguments="njl:JObject" Name="beneficiaries" />
            <Variable x:TypeArguments="njl:JArray" Name="primary" />
            <Variable x:TypeArguments="njl:JArray" Name="contingent" />
            <Variable x:TypeArguments="x:Decimal" Name="pSum" />
            <Variable x:TypeArguments="x:Decimal" Name="cSum" />
        </Sequence.Variables>
        <Assign DisplayName="Default IsValid = True">
            <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsValid]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value>
        </Assign>
        <ui:InvokeWorkflowFile DisplayName="GET /api/beneficiaries" WorkflowFileName="Framework\HttpGet.xaml">
            <ui:InvokeWorkflowFile.Arguments>
                <InArgument x:TypeArguments="x:String" x:Key="in_BaseUrl">[in_BaseUrl]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_ResourcePath">/api/beneficiaries</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_ApiKey">[in_ApiKey]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_EmployeeId">[in_EmployeeId]</InArgument>
                <OutArgument x:TypeArguments="x:Int32" x:Key="out_StatusCode">[status]</OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="out_Body">[body]</OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorCode">[errCode]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
        <If DisplayName="If 200" Condition="[status = 200]">
            <If.Then>
                <Sequence>
                    <ui:DeserializeJson x:TypeArguments="njl:JObject" DisplayName="Parse Beneficiaries" JsonString="[body]" JsonObject="[beneficiaries]" />
                    <Assign DisplayName="Extract Primary">
                        <Assign.To><OutArgument x:TypeArguments="njl:JArray">[primary]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="njl:JArray">[If(beneficiaries IsNot Nothing AndAlso beneficiaries("primary") IsNot Nothing, CType(beneficiaries("primary"), JArray), New JArray())]</InArgument></Assign.Value>
                    </Assign>
                    <Assign DisplayName="Extract Contingent">
                        <Assign.To><OutArgument x:TypeArguments="njl:JArray">[contingent]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="njl:JArray">[If(beneficiaries IsNot Nothing AndAlso beneficiaries("contingent") IsNot Nothing, CType(beneficiaries("contingent"), JArray), New JArray())]</InArgument></Assign.Value>
                    </Assign>
                    <ForEach x:TypeArguments="njl:JToken" DisplayName="Sum Primary" Values="[primary]">
                        <ActivityAction x:TypeArguments="njl:JToken">
                            <ActivityAction.Argument>
                                <DelegateInArgument x:TypeArguments="njl:JToken" Name="pBen" />
                            </ActivityAction.Argument>
                            <Sequence>
                                <Assign DisplayName="Add to pSum">
                                    <Assign.To><OutArgument x:TypeArguments="x:Decimal">[pSum]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:Decimal">[pSum + If(pBen(&quot;allocation&quot;) IsNot Nothing, CDec(pBen(&quot;allocation&quot;)), 0D)]</InArgument></Assign.Value>
                                </Assign>
                            </Sequence>
                        </ActivityAction>
                    </ForEach>
                    <ForEach x:TypeArguments="njl:JToken" DisplayName="Sum Contingent" Values="[contingent]">
                        <ActivityAction x:TypeArguments="njl:JToken">
                            <ActivityAction.Argument>
                                <DelegateInArgument x:TypeArguments="njl:JToken" Name="cBen" />
                            </ActivityAction.Argument>
                            <Sequence>
                                <Assign DisplayName="Add to cSum">
                                    <Assign.To><OutArgument x:TypeArguments="x:Decimal">[cSum]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:Decimal">[cSum + If(cBen(&quot;allocation&quot;) IsNot Nothing, CDec(cBen(&quot;allocation&quot;)), 0D)]</InArgument></Assign.Value>
                                </Assign>
                            </Sequence>
                        </ActivityAction>
                    </ForEach>
                    <If DisplayName="Sums valid (100% if any)?" Condition="[(primary.Count = 0 OrElse pSum = 100D) AndAlso (contingent.Count = 0 OrElse cSum = 100D)]">
                        <If.Then>
                            <Sequence>
                                <If DisplayName="Life line requires primary?" Condition="[in_HasLifeLine AndAlso primary.Count = 0]">
                                    <If.Then>
                                        <Sequence>
                                            <Assign DisplayName="Set BENEFICIARIES_MISSING">
                                                <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsValid]</OutArgument></Assign.To>
                                                <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                                            </Assign>
                                            <Assign DisplayName="Set Code">
                                                <Assign.To><OutArgument x:TypeArguments="x:String">[out_ExceptionCode]</OutArgument></Assign.To>
                                                <Assign.Value><InArgument x:TypeArguments="x:String">BENEFICIARIES_MISSING</InArgument></Assign.Value>
                                            </Assign>
                                            <Assign DisplayName="Set Detail">
                                                <Assign.To><OutArgument x:TypeArguments="x:String">[out_Detail]</OutArgument></Assign.To>
                                                <Assign.Value><InArgument x:TypeArguments="x:String">Life line elected but no primary beneficiary on file</InArgument></Assign.Value>
                                            </Assign>
                                        </Sequence>
                                    </If.Then>
                                </If>
                            </Sequence>
                        </If.Then>
                        <If.Else>
                            <Sequence>
                                <Assign DisplayName="Set Invalid">
                                    <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsValid]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                                </Assign>
                                <Assign DisplayName="Set INVALID_SUM Code">
                                    <Assign.To><OutArgument x:TypeArguments="x:String">[out_ExceptionCode]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:String">BENEFICIARIES_INVALID_SUM</InArgument></Assign.Value>
                                </Assign>
                                <Assign DisplayName="Set Detail">
                                    <Assign.To><OutArgument x:TypeArguments="x:String">[out_Detail]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:String">[&quot;Beneficiary allocations: primary=&quot; &amp; pSum.ToString() &amp; &quot;% contingent=&quot; &amp; cSum.ToString() &amp; &quot;% (must sum to 100%)&quot;]</InArgument></Assign.Value>
                                </Assign>
                            </Sequence>
                        </If.Else>
                    </If>
                </Sequence>
            </If.Then>
            <If.Else>
                <Sequence>
                    <Assign DisplayName="Mark Invalid (HTTP)">
                        <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsValid]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value>
                    </Assign>
                    <Assign DisplayName="Set HTTP ExceptionCode">
                        <Assign.To><OutArgument x:TypeArguments="x:String">[out_ExceptionCode]</OutArgument></Assign.To>
                        <Assign.Value><InArgument x:TypeArguments="x:String">[If(String.IsNullOrEmpty(errCode), &quot;HTTP_&quot; &amp; status.ToString(), errCode)]</InArgument></Assign.Value>
                    </Assign>
                </Sequence>
            </If.Else>
        </If>
    </Sequence>
</Activity>
